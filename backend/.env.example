# ─────────────────────────────────────────────────────
# GITPEN AI — Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# In production (Render), add each key directly in the
# Render dashboard under Environment → Add Environment Variable.
# ─────────────────────────────────────────────────────

# Server
PORT=5001

# MongoDB Atlas connection string
MONGODB_URI=

# OpenRouter — primary LLM provider (https://openrouter.ai)
OPENROUTER_API_KEY=

# Model to use via OpenRouter (e.g. openai/gpt-4o-mini, google/gemini-flash-1.5)
CHAT_MODEL=openai/gpt-4o-mini

# GitHub Personal Access Token (for fetching private/public repo file trees)
GITHUB_TOKEN=

# Optional: Legacy / fallback providers (not required if using OpenRouter)
GEMINI_API_KEY=
GROQ_API_KEY=
